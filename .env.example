# -----------------------------------------------------------------------------
# Devity Backend — пример окружения
# Скопируйте: cp .env.example .env
# Затем: php artisan key:generate   (или в Docker: docker compose exec app php artisan key:generate)
# -----------------------------------------------------------------------------

APP_NAME=Devity
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- База данных ---
# Docker Compose (сервис db): хост = db, как в docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=devityDB
DB_USERNAME=user
DB_PASSWORD=test1234

# Локальный MySQL без Docker (пример):
# DB_HOST=127.0.0.1
# DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum: домены SPA (Vite dev на :5173 или Docker frontend :3000)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:3000,127.0.0.1:5173

# --- Pusher (облако; не используется при BROADCAST_CONNECTION=reverb) ---
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# --- Laravel Reverb (ключи должны совпадать с фронтом VITE_WS_APP_KEY) ---
REVERB_APP_ID=devity-app
REVERB_APP_KEY=devity-key
REVERB_APP_SECRET=devity-secret
# Для браузера / Echo; предпочтительно 127.0.0.1 вместо localhost (IPv6).
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http

# Процесс reverb:start (внутри контейнера слушает 8080; снаружи маппится на 8081)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Явный HTTP-клиент Laravel → Reverb (если не заданы — в config/broadcasting.php
# для Docker подставляются reverb:8080 автоматически при наличии /.dockerenv)
# BROADCAST_REVERB_HOST=reverb
# BROADCAST_REVERB_PORT=8080
# BROADCAST_REVERB_SCHEME=http

# Orchid (админка), по умолчанию из config
# PLATFORM_DOMAIN=
# PLATFORM_PREFIX=/admin

# Vite (если собираете ассеты бэкенда с подстановкой env)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
